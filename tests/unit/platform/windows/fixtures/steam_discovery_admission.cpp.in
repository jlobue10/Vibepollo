
namespace {
  int checks = 0, failures = 0;
  void check(bool ok, const std::string &message) {
    ++checks;
    failures += !ok;
    std::cout << (ok ? "PASS " : "FAIL ") << message << '\n';
  }

  void reset_boundary() {
    process_user = {L"S-1-5-18", true};
    session_users = {{3, {L"S-1-5-21-3"}}, {7, {L"S-1-5-21-7"}}};
    sessions = {{3}};
    own_session = console_session = 3;
    tokens = allocations = 0;
    thread_user = nullptr;
    last_error = ERROR_NO_TOKEN;
    thread_query_ok = impersonate_ok = restore_ok = true;
    enumerate_ok = process_token_ok = token_info_ok = sid_text_ok = user_token_ok = registry_read_ok = true;
    registry_size_override = 0;
    registry.clear();
    queries.clear();
    token_queries.clear();
  }
}

int main(int argc, char **argv) {
  if (argc != 2) return 2;
  namespace fs = std::filesystem;
  using namespace platf::steam;
  const fs::path base = argv[1];
  const auto library = base / "Steam";
  fs::create_directories(library / "steamapps/common/Example");
  std::ofstream(library / "steamapps/appmanifest_42.acf")
    << R"("AppState" { "appid" "42" "name" "Example" "installdir" "Example" })";
  setenv("PROGRAMFILES", base.c_str(), 1);
  unsetenv("PROGRAMFILES(X86)");
  unsetenv("LOCALAPPDATA");

  for (int mode = 0; mode < 9; ++mode) {
    reset_boundary();
    machine_path(RRF_SUBKEY_WOW6432KEY, library.wstring());
    if (mode == 0) sessions.clear();
    if (mode == 1) { sessions = {{3}, {7}}; own_session = 0; console_session = 0xffffffff; }
    if (mode == 2) enumerate_ok = false;
    if (mode == 3) process_token_ok = false;
    if (mode == 4) token_info_ok = false;
    if (mode == 5) sid_text_ok = false;
    if (mode == 6) user_token_ok = false;
    if (mode == 7) thread_query_ok = false;
    if (mode == 8) impersonate_ok = false;
    const auto label = "failed identity mode " + std::to_string(mode) + ": ";
    check(default_library_roots().empty(), label + "no machine or folder fallback scan");
    check(discover({library}).empty(), label + "explicit installed scan is refused");
    check(discover_catalog({library}).empty(), label + "explicit catalog scan is refused");
    check(discover({}).empty() && discover_catalog({}).empty(), label + "default scans are refused");
    check(queries.empty(), label + "failure stops before registry/filesystem discovery");
    check(tokens == 0 && allocations == 0 && thread_user == nullptr, label + "identity resources are released");
  }

  reset_boundary();
  user_path(L"S-1-5-21-3", library.wstring());
  check(default_library_roots() == std::vector<fs::path> {library}, "valid user discovery keeps registry/folder deduplication");
  auto games = discover({library});
  check(games.size() == 1 && games[0].app_id == 42, "valid user still discovers a real installed manifest");
  games = discover_catalog({library});
  check(games.size() == 1 && games[0].name == "Example", "valid user still discovers a real catalog");
  check(tokens == 0 && allocations == 0 && thread_user == nullptr, "successful scans restore the service identity");

  reset_boundary();
  process_user = {L"S-1-5-21-99", false};
  check(discover({library}).size() == 1 && token_queries.empty(), "ordinary desktop process keeps its own identity");

  reset_boundary();
  {
    windows_discovery::discovery_scope outer;
    sessions.clear();
    check(discover({library}).size() == 1 && thread_user == &session_users.at(3),
          "nested successful scan retains the already acquired desktop identity");
  }
  check(thread_user == nullptr && tokens == 0, "nested success restores the original service identity");

  reset_boundary();
  impersonate_ok = false;
  {
    windows_discovery::discovery_scope outer;
    impersonate_ok = true;
    check(discover({library}).empty() && discover_catalog({library}).empty(),
          "nested calls cannot bypass a failed outer identity acquisition");
  }
  check(discover({library}).size() == 1, "a later independent scan can recover after identity acquisition succeeds");
  check(tokens == 0 && allocations == 0 && thread_user == nullptr, "recovery leaves no token or identity behind");
  std::cout << checks << " checks, " << failures << " failures\n";
  return failures != 0;
}
